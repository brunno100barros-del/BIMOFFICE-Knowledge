# Copie para .env e preencha. NUNCA envie o .env para o GitHub (já está no .gitignore).
DB_PASSWORD=troque-esta-senha

# Login obrigatório na nuvem
BIMOFFICE_AUTH=on
BIMOFFICE_ADMIN_EMAIL=admin@exemplo.br
BIMOFFICE_ADMIN_PASSWORD=troque-esta-senha-tambem
BIMOFFICE_CORS_ORIGINS=https://brunno100barros-del.github.io

# Arquivos: local (volume do Docker) ou s3 (armazenamento de objetos do provedor)
BIMOFFICE_STORAGE=local
# BIMOFFICE_STORAGE=s3
# BIMOFFICE_S3_BUCKET=bimoffice-arquivos
# BIMOFFICE_S3_ENDPOINT_URL=https://storage.googleapis.com
# BIMOFFICE_S3_REGION=southamerica-east1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# Limites
BIMOFFICE_MAX_IFC_MB=500
BIMOFFICE_JOB_TIMEOUT_SECONDS=3600
